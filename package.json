{
  "name": "liars-bar",
  "version": "0.1.0",
  "private": true,
  "description": "骗子酒馆 Web 版 —— 服务端权威的隐藏信息牌桌游戏",
  "scripts": {
    "dev": "pnpm --filter @liars/web dev",
    "build": "pnpm --filter @liars/web build",
    "preview": "pnpm --filter @liars/web preview",
    "test": "pnpm --filter @liars/engine test",
    "typecheck": "pnpm -r typecheck",
    "desktop": "electron .",
    "dist:desktop": "pnpm build && electron-builder --config electron-builder.yml",
    "dist:win": "pnpm build && electron-builder --win --config electron-builder.yml",
    "dist:mac": "pnpm build && electron-builder --mac --config electron-builder.yml",
    "dist:linux": "pnpm build && electron-builder --linux --config electron-builder.yml"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@capacitor/android": "^7",
    "@capacitor/cli": "^7",
    "@capacitor/core": "^7",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1"
  },
  "main": "desktop/main.cjs"
}
